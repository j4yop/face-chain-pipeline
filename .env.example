# Copy to .env and fill in. Never commit .env.

# Reverse-image search. Set ONE of the following:
#
# (a) SerpAPI (recommended, no card, no GCP project, 250 searches/month free).
#     Sign up at https://serpapi.com/users/sign_up with GitHub or Google.
#     Free tier never asks for a card and never auto-converts to paid.
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE
#
# (b) Google Cloud Vision WEB_DETECTION. Requires a GCP project with
#     billing enabled (₹1,000 minimum prepayment in India).
#     console.cloud.google.com -> enable Vision API -> create API key.
# GOOGLE_VISION_API_KEY=YOUR_GOOGLE_API_KEY_HERE
#
# (c) Same as (b) but using a service-account JSON key file instead.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-gcp-key.json

# Sepolia testnet RPC. Free Alchemy key: alchemy.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Sepolia sender wallet private key. Use a throwaway wallet, not your main.
# Fund it at https://faucet.quicknode.com/ethereum/sepolia (~0.1 ETH free).
SEPOLIA_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY
